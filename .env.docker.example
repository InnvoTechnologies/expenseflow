# Copy to .env.docker. These credentials are separate from a development .env.
# Generate each secret independently with: openssl rand -hex 32
# Use a hex database password so it is safe inside the connection URL.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

APP_URL=http://localhost:3000
APP_PORT=3000
# Loopback by default. Use 0.0.0.0 only if direct network access is intended.
APP_BIND_ADDRESS=127.0.0.1
NEXT_PUBLIC_APP_NAME=ExpenseFlow

# Local-only Cloudflare test keys. Replace BOTH with real keys for a public site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Configure Resend and a verified sender for signup verification/password resets.
RESEND_API_KEY=
RESEND_FROM=ExpenseFlow <no-reply@example.com>

# Optional Google sign-in. Register APP_URL/api/auth/callback/google with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional finance copilot. No key is needed to start the finance application.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna

# Optional client-side telemetry. Changing NEXT_PUBLIC_* requires a rebuild.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
